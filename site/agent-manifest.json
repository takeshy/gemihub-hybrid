{
  "brand": "街の案内",
  "networks": [
    {
      "name": "reservation_finder",
      "front_man": "finder_front",
      "hocon": "./reservation_finder.network.json",
      "description": "街のお知らせ、イベント、公共施設、暮らしの情報を公開資料からご案内します。登録されているお店の紹介や、希望する方には飲食店の予約相談もお手伝いします。",
      "tags": [
        "agentified-website",
        "local-guide",
        "published-documents",
        "restaurant-reservation",
        "multi-site"
      ],
      "sample_queries": [
        "今度の地域のイベントを教えて",
        "図書館の開館時間を教えて",
        "公民館の利用方法を知りたい",
        "新宿で贈り物が見つかる雑貨店を教えて",
        "今夜19時に2人、席だけ空いている店は？",
        "3店の空席を比べて"
      ]
    }
  ],
  "llm_router": {
    "base_url": "https://openrouter.ai/api/v1",
    "mock": false,
    "byok_router": "https://openrouter.ai/api/v1"
  },
  "allowed_peers": [
    "https://gemihub-hybrid-2026.web.app"
  ],
  "peer_policy": {
    "mode": "closed",
    "deny_origins": [],
    "note": "Calls registered shop agents only after visitor consent. Agent connectivity does not imply reservation support."
  },
  "agent_mcp": {
    "protocol": "nsdeploy-agent-mcp/v1",
    "network": "reservation_finder",
    "front_man": "finder_front",
    "available": false,
    "reason": "This is a static bundle; a public MCP facade requires an application host."
  },
  "theme": {
    "primary": "#28594b"
  },
  "linking": {
    "protocol": "nsdeploy-link/v1",
    "exports": [
      {
        "network": "reservation_finder",
        "front_man": "finder_front",
        "aliases": [
          "reservation_finder",
          "finder_front"
        ],
        "url": "reservation_finder"
      }
    ],
    "imports": [],
    "link_updates": {
      "mode": "browser-local"
    }
  },
  "deployment": {
    "mode": "static",
    "self_contained_runtime": true,
    "browser_mock": false,
    "direct_byok": true,
    "direct_mcp_requires_cors": true,
    "public_mcp_facade": false
  },
  "actions": {
    "version": 1,
    "module": "./site-actions.js",
    "bridge": "./bridge/action-bridge.html",
    "agentTools": [
      "get_finder_state",
      "list_registered_shops",
      "set_reservation_conditions",
      "confirm_shop_inquiries",
      "show_candidates",
      "open_shop",
      "open_shop_page",
      "show_shop_introductions",
      "search_chat_documents"
    ]
  }
}
